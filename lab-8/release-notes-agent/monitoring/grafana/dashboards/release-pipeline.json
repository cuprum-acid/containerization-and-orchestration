          "expr": "sum(increase(n8n_workflow_success_total[15m]))",
          "legendFormat": "success",
          "refId": "A",
          "interval": "1m"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(n8n_workflow_failed_total[15m]))",
          "legendFormat": "failed",
          "refId": "B",
          "interval": "1m"
