    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.owner }}/{{ $('Config').first().json.repo }}/releases?per_page=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
