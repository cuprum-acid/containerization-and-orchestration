    {
      "parameters": {
        "jsCode": "// Only changes under the API directory make a release: the repository also\n// holds the other labs, and a push of a lab report must not ship anything.\nconst plan = $('Plan').first().json;\nconst cmp = $json;\nconst inApi = (f) => f.filename.startsWith(plan.apiPath) || (f.previous_filename ?? '').startsWith(plan.apiPath);\nconst files = (cmp.files ?? []).filter(inApi).map((f) => f.filename);\nconst commits = (cmp.commits ?? []).map((c) => ({ id: c.sha, message: c.commit.message }));\nreturn [{ json: { ...plan, apiChanged: files.length > 0, files, commits } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "id": "5827c938-13e9-5a7c-9680-f01f7fa5a765",
      "name": "Collect API changes"
    },
