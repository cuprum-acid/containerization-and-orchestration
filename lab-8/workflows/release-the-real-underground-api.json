      "parameters": {
        "method": "POST",
        "url": "http://agent:8080/release",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ owner: $json.owner, repo: $json.repo, sha: $json.headSha, last_tag: $json.lastTag, commits: $json.commits }) }}",
        "options": {
          "timeout": 330000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2200,
        100
      ],
      "id": "452c020e-a93f-560e-a8b9-77b3713e553f",
      "name": "Ask the agent"
    },
    {
      "parameters": {
        "jsCode": "// The agent only proposes. Everything below is plain code: its answer is\n// checked, the version is computed, and a declared breaking change can never\n// be released as less than major.\nconst ctx = $('Collect API changes').first().json;\nconst a = $json;\n\nconst errors = [];\nif (!['major', 'minor', 'patch'].includes(a.bump)) errors.push(`bump=${a.bump}`);\nif (typeof a.title !== 'string' || !a.title.trim() || a.title.length > 70) errors.push('title');\nif (typeof a.notes !== 'string' || a.notes.trim().length < 20) errors.push('notes');\nif (errors.length) throw new Error('Agent answer rejected: ' + errors.join(', '));\n\nconst breaking = ctx.commits.filter((c) =>\n  /BREAKING[ -]CHANGE/.test(c.message) || /^\\w+(\\([^)]*\\))?!:/.test(c.message));\nlet bump = a.bump;\nlet override = null;\nif (breaking.length && bump !== 'major') {\n  override = `the agent proposed ${bump}, but ${breaking.length} commit(s) declare a breaking change`;\n  bump = 'major';\n}\n\nconst [M, m, p] = ctx.lastVersion.split('.').map(Number);\nconst version = { major: `${M + 1}.0.0`, minor: `${M}.${m + 1}.0`, patch: `${M}.${m}.${p + 1}` }[bump];\n// A major release breaks integrations: a person reads it before clients do.\nconst draft = bump === 'major';\n\nlet body = a.notes.trim();\nif (override) body = `> Version bump raised by the release pipeline: ${override}.\\n\\n${body}`;\nif (draft) body += `\\n\\n---\\n**Draft for review.** Agent reasoning: ${a.reasoning}`;\n\nreturn [{ json: {\n  ...ctx, bump, agentBump: a.bump, override, version,\n  tag: ctx.tagPrefix + version, title: a.title.trim(), body, draft,\n  agentTurns: a.meta?.num_turns, agentCostUsd: a.meta?.cost_usd,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        100
      ],
      "id": "a8c86d69-afb1-5107-9652-dd855e9c98be",
