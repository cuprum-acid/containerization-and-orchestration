      "id": "11f8befc-c3d1-5a79-a5e7-5bb7ea817500",
      "name": "List releases",
      "credentials": {
        "githubApi": {
          "id": "BWDCzt6XR2ZL7VM6",
          "name": "GitHub account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Deterministic part: which release is the last one, and what to do now.\n// Releases, not tags: a draft release has no tag yet, but it still counts -\n// otherwise every run would open the same draft again.\nconst cfg = $('Config').first().json;\nconst headSha = $('Main head').first().json.object.sha;\n\nconst parse = (tag) => {\n  const m = tag.slice(cfg.tagPrefix.length).match(/^(\\d+)\\.(\\d+)\\.(\\d+)$/);\n  return m ? m.slice(1).map(Number) : null;\n};\n// Compare numerically: as strings, 1.10.0 sorts before 1.9.0.\nconst cmp = (a, b) => a[0] - b[0] || a[1] - b[1] || a[2] - b[2];\n\nconst releases = $('List releases').all()\n  .map((i) => i.json)\n  .filter((r) => r.tag_name?.startsWith(cfg.tagPrefix) && parse(r.tag_name))\n  .sort((a, b) => cmp(parse(b.tag_name), parse(a.tag_name)));\nconst last = releases[0];\n\nlet action = 'check';\nif (!last) action = 'initial';\nelse if (last.draft) action = 'wait_for_draft';\n\nreturn [{ json: {\n  ...cfg,\n  headSha,\n  action,\n  lastTag: last?.tag_name ?? null,\n  lastVersion: last ? parse(last.tag_name).join('.') : null,\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "id": "1b5de314-53ad-5f9b-b0a7-76a8958a3091",
      "name": "Plan"
    },
    {
