{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "api chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicas": { "type": "integer", "minimum": 0 },
    "otlpEndpoint": {
      "type": "string",
      "description": "OTLP/HTTP base URL, e.g. http://jaeger.monitoring.svc:4318; empty disables export",
      "pattern": "^$|^https?://"
    },
    "resources": { "type": "object" },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "errorRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "latencySeconds": { "type": "number", "exclusiveMinimum": 0 },
        "runbookBaseUrl": { "type": "string", "pattern": "^https?://" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
